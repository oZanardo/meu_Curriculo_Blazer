    {
        new Experiencia {
            Empresa = "World-Tennis",
            Cargo = "Vendedor",
            Inicio = "2024",  Fim = "2025",
            Descricao = "Atuei como vendedor ajudando e recomendando os clientes sobre os produtos mais indicados para eles"
        },
        new Experiencia {
            Empresa = "Logoplaste LTDA.",
            Cargo = "Auxiliar de produção",
            Inicio = "2021", Fim = "2023",
            Descricao = "Responsavel pelo final da linha de produção e também pela implementação de programas de melhoria continua"
        }
    };

    private List<Experiencia> Projetos = new()
    {
        new Experiencia
        {
            Empresa = "Stacks: Python| postgreSQL| Docker",
            Inicio = "2026",Fim = string.Empty,
            Cargo = "Analise de dados do Banco Central",
            Descricao = "Fazendo a ingestão da API do Banco Central e primeiro projeto utilizando Python, Docker e postgreSQL." +
                        "\nO objetivo desse projeto é analisar como as empresas se comportam na tomada de crédito mediante a taxa Selic, e ao IPCA nacional"
        },
        new Experiencia
        {
