@page "/"


<PageTitle>Currículo | Dev .NET</PageTitle>

<div class="container py-4">
    <div class="row">
        <div class="col-lg-4">
            <div class="text-center p-4 bg-light rounded-3 mb-4">
                <img src="https://media.licdn.com/dms/image/v2/D4D35AQGq1yymnYDAgw/profile-framedphoto-shrink_400_400/B4DZu57uRCHYAc-/0/1768350999898?e=1777770000&v=beta&t=QJrNDN6ndgGmlI-uhNFvLNHU6G1VRr3r-uXVmYBI4oc" class="rounded-circle mb-3"
                     width="120" />
                <h3>João Victor Zanardo</h3>
                <p class="text-muted">Desenvolvedor Fullstack</p>
            </div>
        </div>

        <div class="col-lg-8">
            <h2 class="mb-4">Experiência Profissional</h2>
            
            @foreach (var exp in MinhasExperiencias)
            {
                <ExperienceCard Dados='exp' />
            }
            <h2 class="mb-4">Projetos Pessoais</h2>
            @foreach(var xp in Projetos) {<ExperienceCard Dados="xp" />}
        </div>
    </div>
</div>

@code {
